    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "pyodide": "0.29.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
